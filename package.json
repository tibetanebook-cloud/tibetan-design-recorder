{
  "name": "nangchen-t-studio-screen-recorder",
  "productName": "Nangchen T. Studio Screen Recorder",
  "version": "0.2.1",
  "description": "Screen recorder and multi-track video editor for teaching, with Tibetan and English UI.",
  "author": "Nangchen T. Studio",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "smoke": "npm run build && node scripts/run-smoke.mjs",
    "smoke:l10n": "npm run build && node scripts/run-smoke.mjs --no-record --l10n",
    "screenshots": "npm run build && electron . --smoke-test --showcase",
    "i18n:report": "python scripts/i18n/tibetan_terms.py report",
    "i18n:lint": "node --experimental-strip-types --no-warnings scripts/i18n/lint-json.ts",
    "icons": "python build/icon-source/make_icons.py",
    "dist:win": "npm run licenses && npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run licenses && npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run licenses && npm run build && electron-builder --linux --publish never",
    "licenses": "node scripts/collect-licenses.mjs",
    "dist:dir": "npm run licenses && npm run build && electron-builder --win --dir --publish never",
    "dist:win-arm64": "npm run licenses && npm run build && electron-builder --win nsis --arm64 --publish never"
  },
  "dependencies": {
    "uiohook-napi": "1.5.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@fontsource/noto-serif-tibetan": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "gifenc": "1.0.3",
    "mp4-muxer": "5.2.2",
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "webm-muxer": "5.1.4",
    "zustand": "5.0.15"
  }
}
